# Copy to .env.local and fill in. App falls back to mock data if these are missing.
# Everything except NEXT_PUBLIC_* is server-side only.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Inkbox (iMessage)
INKBOX_API_KEY=
# The Inkbox agent identity that answers iMessages (without "@").
INKBOX_AGENT_HANDLE=fenland-ridge-risk
INKBOX_WEBHOOK_SECRET=
# Risk agent (Gemini). Judge: gemini-4-argon. Document and photo reader: gemini-3.8-flash.
GEMINI_API_KEY=
RISK_AGENT_MODEL=gemini-4-argon
RISK_READER_MODEL=gemini-3.8-flash
# Set to 1 only after supabase/migrations/0005_agent_runs.sql is applied
AGENT_TABLES=
# Postgres URL for the restricted risk_agent role (optional; the agent store uses it when set)
RISK_AGENT_DATABASE_URL=
# TypeSafe (Jev) input screen
TYPESAFE_API_KEY=
# Bearer token for /api/mcp; unset disables the route
MCP_TOKEN=

# Optional: only answer these senders (comma-separated phone numbers or Apple IDs). Unset = anyone who connects.
INKBOX_ALLOWED_SENDERS=

# Optional: password for the whole deployed app (HTTP Basic, any username). Unset = open.
HEDGED_PASSWORD=
